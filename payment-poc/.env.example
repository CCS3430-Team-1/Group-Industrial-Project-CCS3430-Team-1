#This is an example .env file. 
#Remove the .example from the filename and fill in the values below to use this project.

#stripe keys can be found in your stripe dashboard at Settings > Developers > API keys
STRIPE_SECRET_KEY=your_stripe_secret_key

#viva keys can be found in your viva dashboard at Settings > API Access > Smart Checkout Credentials
VIVA_CLIENT_ID=your_viva_id
VIVA_CLIENT_SECRET=your_viva_secret
VIVA_SOURCE_CODE=Default